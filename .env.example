# ══════════════════════════════════════════════
# PORT — do NOT set on Railway
# Railway auto-injects PORT. Backend reads it.
# Only set this for LOCAL development.
# ══════════════════════════════════════════════
# PORT=3000

# ── Server ──
NODE_ENV=production

# ── Minecraft ──
MC_VERSION=1.20.4
MC_RAM_MIN=512M
MC_RAM_MAX=1536M
MC_SERVER_PORT=25565

# ── RCON (must match server.properties) ──
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=change-this-to-something-random

# ── Paths ──
MC_DIR=/app/minecraft
BACKUP_DIR=/app/minecraft/backups
LOG_FILE=/app/minecraft/logs/console.log

# ── Playit.gg ──
# Leave empty to use claim-URL flow.
# Or paste your secret here for headless deploys.
PLAYIT_SECRET=

# ── Optional ──
API_KEY=
